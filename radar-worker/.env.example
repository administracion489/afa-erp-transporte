# radar-worker/.env.example — copiar a .env y completar con los valores reales.
# El worker corre FUERA de Vercel (PC de la oficina o VPS), por eso tiene su propio .env.

# URL del proyecto de Supabase (la misma NEXT_PUBLIC_SUPABASE_URL del ERP,
# se ve en Supabase > Settings > API > Project URL).
SUPABASE_URL=

# Clave service_role de Supabase (Settings > API > service_role). Da acceso TOTAL
# a la base de datos: nunca compartirla ni subirla a git.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del ERP en Vercel, SIN barra final (p.ej. https://afa-erp.vercel.app).
# El worker la usa para avisarle al ERP que hay mensajes nuevos por procesar.
ERP_URL=

# Secreto compartido con el ERP para autenticar el aviso de procesamiento
# (mismo valor que la variable RADAR_WORKER_SECRET en Vercel). Inventar una
# cadena larga y aleatoria, p.ej. con: node -e "console.log(crypto.randomUUID())"
RADAR_WORKER_SECRET=

# (Opcional) Carpeta donde se guarda la sesión de WhatsApp. Por defecto ./auth
# Respaldar esta carpeta = no volver a escanear el QR.
# AUTH_DIR=./auth
