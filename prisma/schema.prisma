generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nombre    String
  telefono  String?
  email     String?
  tipo      String?
  empresa   String?
  ruc       String?
  dni       String?
  createdAt DateTime @default(now())
}