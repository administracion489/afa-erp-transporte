+    private void requestLocationUpdatesMultiProvider(float distanceFilter) {
+        if (client == null || locationCallback == null) {
+            return;
+        }
+        java.util.List<String> providers = new java.util.ArrayList<>();
+        if (Build.VERSION.SDK_INT >= 31) {
+            // FUSED_PROVIDER (API 31+) fusiona GPS + red + WiFi.
+            providers.add(LocationManager.FUSED_PROVIDER);
+        }
+        providers.add(LocationManager.GPS_PROVIDER);
+        providers.add(LocationManager.NETWORK_PROVIDER);
+
+        boolean requested = false;
+        for (String provider : providers) {
+            try {
+                if (client.isProviderEnabled(provider)) {
+                    client.requestLocationUpdates(provider, HEARTBEAT_INTERVAL_MS, 0f, locationCallback);
+                    requested = true;
+                    // En API 31+ basta FUSED; evita duplicar fixes pidiendo a varios.
+                    if (Build.VERSION.SDK_INT >= 31 && LocationManager.FUSED_PROVIDER.equals(provider)) {
+                        return;
+                    }
+                }
