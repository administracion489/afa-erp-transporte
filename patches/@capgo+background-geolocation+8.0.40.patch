+                // Permisos: se gestionan en el lado JS antes de start().
+            } catch (IllegalArgumentException ignore) {
+                // El proveedor no existe en este dispositivo.
+            }
+        }
+        if (!requested) {
+            Logger.info("No hay proveedor de ubicación habilitado (GPS/NETWORK/FUSED)");
+        }
+    }
